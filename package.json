{
  "name": "ariel-professional-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "validate": "node scripts/validate.mjs",
    "test": "playwright test",
    "audit:dependencies": "npm audit",
    "test:content": "node --test tests/content.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "linkedom": "0.18.13",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.12.1"
}
